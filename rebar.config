{erl_opts, [debug_info]}.
{deps, [
    {jsx, ">= 2.8.0 and < 4.0.0"},
    {mapz, "~> 2.2"},
    bbmustache,
    hackney,
    edifa,
    grisp_update_packager
]}.
%% Cargo is optional in ordinary consumers. The dialyzer profile below includes
%% it and checks unknown calls and types; CI uses that complete analysis.
{dialyzer, [{warnings, [no_unknown]}]}.
{profiles, [
    {test, [{deps, [
        {cargo, {git, "https://github.com/grisp/erlang-cargo.git",
                 {branch, "cross_build_support_0_1_3"}}}
    ]}]},
    {dialyzer, [
        {deps, [
            {cargo, {git, "https://github.com/grisp/erlang-cargo.git",
                     {branch, "cross_build_support_0_1_3"}}}
        ]},
        {dialyzer, [{warnings, [unknown]}, {plt_extra_apps, [cargo]}]}
    ]}
]}.
{project_plugins, [rebar3_ex_doc]}.
{hex, [{doc, ex_doc}]}.
{ex_doc, [
    {extras, [
          {"CHANGELOG.md", #{title => "Changelog"}},
          {"README.md", #{title => "Overview"}},
          {"LICENSE", #{title => "License"}}
    ]},
    {main, "README.md"},
    {homepage_url, "https://github.com/grisp/grisp_tools"},
    {source_url, "https://github.com/grisp/grisp_tools"}
]}.
